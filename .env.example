# ------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#   PowerShell:  Copy-Item .env.example .env.local
# Never commit .env.local – it is already in .gitignore.
# ------------------------------------------------------------------

# Supabase → your project → Project Settings → API (or "Data API"):
#   "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
# (The older "anon public" key also works here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address the app runs at. Used to build sign-in and invite links.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Email (RSVP invitations & reminders) – optional, see README "Set up Resend"
# ------------------------------------------------------------------
# Resend → API Keys → Create API key (starts with re_)
RESEND_API_KEY=
# The address emails come from. Leave empty to use onboarding@resend.dev,
# which can ONLY send to your own Resend account email (fine for testing).
# After verifying your domain in Resend: e.g. rsvp@yourdomain.com
EMAIL_FROM=

# ------------------------------------------------------------------
# Optional extras (the app works without them)
# ------------------------------------------------------------------
# Supabase → Project Settings → API Keys → Secret key (starts with sb_secret_).
# SERVER ONLY – never share it or put it in a NEXT_PUBLIC_ variable.
# Enables: emailing the couple when someone RSVPs, "opened" email status,
# and the demo data / automated tests below.
SUPABASE_SECRET_KEY=
# Resend → Webhooks → your endpoint → Signing secret (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Unsplash → https://unsplash.com/developers → Your apps → New Application → "Access Key"
# (not the Secret key). SERVER ONLY. Enables "Discover" photos on the Inspiration page.
UNSPLASH_ACCESS_KEY=
# Booking.com affiliate program → Your affiliate ID. If set, hotel search links
# on the website and hotels page include this ID. Leave empty to use plain links.
BOOKING_AFFILIATE_ID=

# ------------------------------------------------------------------
# Demo data and tests (only on your computer; not needed on Vercel)
# ------------------------------------------------------------------
# The email you sign in to Vow with. "npm run seed" makes you the owner of a
# demo wedding (Sofia & Lucas). Sign in once before running it.
SEED_OWNER_EMAIL=
# "npm run test:e2e" signs in as this account (defaults to SEED_OWNER_EMAIL).
E2E_EMAIL=
# Use a browser that's already installed instead of downloading one:
# msedge (Windows), chrome, or leave empty after "npx playwright install chromium".
PW_CHANNEL=
